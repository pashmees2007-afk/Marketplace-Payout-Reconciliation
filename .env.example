# Copy this file to .env and fill in values as needed.
# The entire application works with zero configuration (LLM_MODE=mock,
# no API key) -- copying this file is optional, not required to run the demo.

# ---------------------------------------------------------------------------
# AI explanation layer
# ---------------------------------------------------------------------------
# "mock"  -> deterministic, rule-based explanations. No network calls, no
#            API key required. This is the default and is what the dashboard
#            uses out of the box.
# "live"  -> call the real Anthropic API for explanations. Requires
#            ANTHROPIC_API_KEY below. If the call fails for any reason
#            (missing key, network error, malformed response), the system
#            automatically falls back to the mock explanation and logs the
#            fallback reason in output/audit_log.jsonl -- it never crashes
#            the pipeline or the dashboard.
LLM_MODE=mock

# Only used when LLM_MODE=live. Get a key at https://console.anthropic.com/
# NEVER commit a real key to source control.
ANTHROPIC_API_KEY=

# Any valid Anthropic model id. Only used when LLM_MODE=live.
LLM_MODEL=claude-haiku-4-5-20251001

# Max tokens for each AI explanation response.
LLM_MAX_TOKENS=400

# Per-request timeout (seconds) for live LLM calls.
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Reconciliation engine
# ---------------------------------------------------------------------------
# Tolerance (in paise) below which a non-exact subset is still considered
# "explained" -> CLOSE_MATCH instead of UNRESOLVED. 3000 paise = ₹30.
TOLERANCE_PAISE=3000

# Only orders dated on/before a payout's date, and no more than this many
# days earlier, are eligible to be matched to that payout.
ELIGIBILITY_WINDOW_DAYS=30

# Eligible-order-set sizes at/below this are searched exhaustively
# (2^n combinations). Above it, the maximum subset size searched is capped
# at CAPPED_SUBSET_SIZE to keep runtime bounded -- see reconcile.py.
FULL_SEARCH_MAX_ELIGIBLE=16
CAPPED_SUBSET_SIZE=8

# ---------------------------------------------------------------------------
# Synthetic data generation
# ---------------------------------------------------------------------------
# Fixed by default so every run is reproducible. Override to get a
# different (still reproducible) dataset.
RANDOM_SEED=42
NUM_SELLERS=20
MIN_ORDERS_PER_SELLER=10
MAX_ORDERS_PER_SELLER=30
ORDER_SPAN_DAYS=16
